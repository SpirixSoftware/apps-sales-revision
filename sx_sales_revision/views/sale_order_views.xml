<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_inherit_sx_sales_revision" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sx.sales.revision</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="revision_count" invisible="1"/>
                <button class="oe_stat_button" type="object"
                        name="action_view_revised_orders"
                        icon="fa-pencil-square-o"
                        invisible="revision_count &lt;= 1">
                    <field name="revision_count"
                           string="Orders Family"
                           widget="statinfo"/>
                </button>
            </xpath>
             <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">state not in ['sent','has_revision', 'revised']</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent', 'sale', 'has_revision', 'revised'] or not id or locked</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button class="btn-primary"
                        name="action_create_revision"
                        string="Create Revision"
                        type="object"
                        invisible="state not in ['sent','has_revision', 'revised']"/>
            </xpath>
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="sales_revisions" string="Sale Revisions" invisible="revision_count == 0">
                    <field name="revised_order_ids">
                        <list>
                            <field name="date_order"/>
                            <field name='name'/>
                            <field name="partner_id"/>
                            <field name='user_id'/>
                            <field name='state'/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
